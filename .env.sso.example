# OpenSign-Quantum SSO settings, read by the server container only (docker-compose.sso.yml).
# Copy to .env.sso and fill in. Never commit .env.sso. Full reference: docs/SSO.md
# Replace sign.example.com with your HOST_URL host. Behind the bundled Caddy, SSO URLs live under /api.

SSO_ENABLED=true
# oidc | saml
SSO_PROTOCOL=oidc
SSO_DISPLAY_NAME=Company SSO
SSO_AUTO_PROVISION=true
SSO_REQUIRE_VERIFIED_EMAIL=true
# Random 32+ char secret for the SSO flow cookie (e.g. `openssl rand -hex 32`)
SSO_COOKIE_SECRET=

# ---------- OIDC (SSO_PROTOCOL=oidc) ----------
OIDC_ISSUER=https://sso.example.com/realms/company
OIDC_CLIENT_ID=opensign
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=https://sign.example.com/api/auth/oidc/callback

# ---------- SAML (SSO_PROTOCOL=saml) ----------
SAML_IDP_METADATA_URL=
SAML_SP_ENTITY_ID=https://sign.example.com
SAML_ACS_URL=https://sign.example.com/api/auth/saml/callback
SAML_EMAIL_ATTRIBUTE=email
SAML_NAME_ATTRIBUTE=name
# Only if the IdP issues transient NameIDs: an immutable attribute such as objectGUID
SAML_SUBJECT_ATTRIBUTE=
