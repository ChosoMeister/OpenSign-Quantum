# OpenSign server against the local test Keycloak, SAML (plain-http local test only).
export MONGODB_URI=mongodb://localhost:27018/opensign-sso-test
export MASTER_KEY=test-master-key
export APP_ID=opensign
export SERVER_URL=http://localhost:8080/app
export PUBLIC_URL=http://localhost:3000
export USE_LOCAL=true
export SSO_ENABLED=true
export SSO_PROTOCOL=saml
export SSO_DISPLAY_NAME="Company SSO"
export SAML_IDP_METADATA_URL=http://localhost:8180/realms/company/protocol/saml/descriptor
export SAML_SP_ENTITY_ID=http://localhost:8080
export SAML_ACS_URL=http://localhost:8080/auth/saml/callback
# Role mapping from Keycloak groups; local email/password login turned off.
export SSO_ADMIN_GROUPS=opensign-admins
export SSO_ORGADMIN_GROUPS=opensign-orgadmins
export SSO_EDITOR_GROUPS=opensign-editors
export LOCAL_LOGIN_ENABLED=false
export SSO_COMPANY_NAME="Acme Test"
