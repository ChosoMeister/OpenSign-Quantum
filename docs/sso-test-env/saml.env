# Source before `npm start` in apps/OpenSignServer (plain-http local test only).
export MONGODB_URI=mongodb://localhost:27018/opensign-sso-test
export MASTER_KEY=test-master-key
export APP_ID=opensign
export SERVER_URL=http://localhost:8080/app
export PUBLIC_URL=http://localhost:3000
export USE_LOCAL=true
export SSO_ENABLED=true
export SSO_PROTOCOL=saml
export SSO_DISPLAY_NAME="Test SSO"
export SAML_IDP_METADATA_URL=http://localhost:8081/simplesaml/saml2/idp/metadata.php
export SAML_SP_ENTITY_ID=http://localhost:8080
export SAML_ACS_URL=http://localhost:8080/auth/saml/callback
# Test IdP issues transient NameIDs and releases only email; production should use an immutable ID.
export SAML_SUBJECT_ATTRIBUTE=email
