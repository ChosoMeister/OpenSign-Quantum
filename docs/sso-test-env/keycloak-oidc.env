# OpenSign server against the local test Keycloak, OIDC (plain-http local test only).
export MONGODB_URI=mongodb://localhost:27018/opensign-sso-test
export MASTER_KEY=test-master-key
export APP_ID=opensign
export SERVER_URL=http://localhost:8080/app
export PUBLIC_URL=http://localhost:3000
export USE_LOCAL=true
export SSO_ENABLED=true
export SSO_PROTOCOL=oidc
export SSO_DISPLAY_NAME="Company SSO"
export SSO_INSECURE_COOKIES=true
export OIDC_ISSUER=http://localhost:8180/realms/company
export OIDC_CLIENT_ID=opensign
export OIDC_CLIENT_SECRET=kc-test-secret
export OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
export OIDC_ALLOW_INSECURE_HTTP=true
